{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campus-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": { "bindings": [{ "name": "WORKSPACES", "class_name": "Workspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-accounts",
      "database_id": "18b29ab5-ff38-438c-bb87-42aaf7f79f7f",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "PUBLIC_APP_URL": "https://campus-planner.mymemory9.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
