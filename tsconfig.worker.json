{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["worker/**/*.ts", "worker/**/*.d.ts", "worker-configuration.d.ts"],
  "exclude": ["worker/**/*.test.ts", "worker/tests/**"]
}
