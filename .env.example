# Public HTTPS origin that Telegram can call.
# Example: https://campus.example.com
TELEGRAM_WEBHOOK_BASE_URL=

# Optional base64-encoded 32-byte key. If omitted, a local key is generated in .data/.
# Generate: openssl rand -base64 32
TELEGRAM_TOKEN_ENCRYPTION_KEY=

# Shared only between Campus backend and the separate WhatsApp Bridge.
# Never expose this value to the browser.
WHATSAPP_BRIDGE_SECRET=

PORT=8787
CAMPUS_DATA_DIR=.data
